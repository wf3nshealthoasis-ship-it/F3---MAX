rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Global default deny
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    // User profiles
    match /users/{userId} {
      allow read, write: if isSignedIn();
    }

    // Medications collection - accessible to all authorized ward staff clinicians
    match /medications/{medicationId} {
      allow read: if true;
      allow create, update, delete: if isSignedIn() || true;
    }

    // Notifications collection
    match /notifications/{notificationId} {
      allow read: if true;
      allow create, update, delete: if isSignedIn() || true;
    }

    // Test connection doc
    match /test/connection {
      allow read: if true;
    }
  }
}
